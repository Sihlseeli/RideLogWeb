@page "/activities"
@using RideLogWeb.Models
@using RideLogWeb.Services
@inject ActivityService ActivityService

<h1>📋 Alle Fahrten</h1>

@if (activities.Count == 0)
{
    <div class="empty-state">Noch keine Fahrten erfasst 🚴</div>
}
else
{
    <div class="card">
        @foreach (var a in activities)
        {
            <div class="activity-item">
                <div class="activity-icon">
                    @(a.BikeType == BikeType.MTB ? "🚵" : "🚴")
                </div>
                <div class="activity-info">
                    <div class="activity-title">@a.Title</div>
                    <div class="activity-date">
                        @a.Date.ToString("dd.MM.yyyy")
                    </div>
                </div>
                <div class="activity-stats">
                    <div class="activity-km">
                        @a.Kilometers.ToString("F1") km
                    </div>
                    <div class="activity-hm">@a.ElevationMeters hm</div>
                </div>
                <button @onclick="() => DeleteActivity(a)"
                        style="background:none; border:none;
                    font-size:18px; cursor:pointer;">
                    🗑️
                </button>
            </div>
        }
    </div>
}

@code {
    private List<Activity> activities = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        activities = await ActivityService.GetActivitiesAsync();
        StateHasChanged();
    }

    private async Task DeleteActivity(Activity activity)
    {
        await ActivityService.DeleteActivityAsync(activity);
        await LoadAsync();
    }

}